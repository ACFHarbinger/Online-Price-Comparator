# =============================================================================
# Online Price Comparator Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO
PROJECT_ID=
GITHUB_TOKEN=
GEMINI_API_KEY=

# SQLite database file path (relative or absolute)
DATABASE_PATH=data/price_comparator.db

# Comma-separated site keys to enable, e.g. "pccomponentes,amazon.es"
# Leave empty to enable all registered scrapers.
ENABLED_SCRAPERS=

# Optional search-API providers. The tool works with none of these configured
# (scrapers alone are enough); each is skipped gracefully if its key is unset.
SERPAPI_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Reliability / polite-fetch tuning. Defaults are conservative after observed
# Amazon Akamai and PcComponentes Cloudflare blocking. See
# docs/moon/roadmaps/scrapers_and_retailers.md (Reliability hardening).
REQUEST_JITTER_FRACTION=0.20
RETRY_MAX_ATTEMPTS=2
RETRY_INITIAL_BACKOFF_SECONDS=2.0
RETRY_MAX_BACKOFF_SECONDS=30.0
BLOCK_CIRCUIT_BREAKER_FAILURES=2
BLOCK_CIRCUIT_BREAKER_COOLDOWN_HOURS=24.0
RESPONSE_CACHE_TTL_SECONDS=600
ROBOTS_CACHE_TTL_HOURS=24.0

# Headless-browser fallback (Playwright) for sites a plain httpx request
# can't get past (e.g. PcComponentes' Cloudflare JS challenge). Off by
# default; requires `uv sync --extra browser` +
# `uv run playwright install chromium` to actually work once enabled.
BROWSER_FALLBACK_ENABLED=false
BROWSER_FALLBACK_SITES=pccomponentes

# Set to false to open a real, visible browser window instead of a
# headless one when the fallback triggers - useful if a site's challenge
# needs a human to click through it rather than auto-resolving. The wait
# is extended (BROWSER_FALLBACK_MANUAL_WAIT_SECONDS) to give you time to
# interact with it before the page is captured.
BROWSER_FALLBACK_HEADLESS=true
BROWSER_FALLBACK_HEADLESS_WAIT_SECONDS=5.0
BROWSER_FALLBACK_MANUAL_WAIT_SECONDS=45.0
